# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). A chave publishable/anon é pública por natureza:
# a segurança vem das regras de acesso (RLS) em supabase/schema.sql.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publishable-ou-anon
